{
  "name": "specstride-site",
  "version": "0.1.0",
  "private": true,
  "description": "Website for Specstride, built as a reusable template",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "gen": "node scripts/gen-ascii.mjs && node scripts/gen-og.mjs",
    "build": "npm run gen && astro build && node scripts/csp-hash.mjs",
    "preview": "astro preview",
    "check": "astro check",
    "deploy": "bash scripts/deploy.sh"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/inter": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "astro": "^7.3.5",
    "axe-core": "^4.13.0",
    "lighthouse": "^13.5.0",
    "linkinator": "^8.1.0",
    "playwright": "^1.63.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.145.0"
  }
}
