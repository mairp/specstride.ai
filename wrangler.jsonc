{
  // Static site on Workers with static assets. worker/index.js only redirects
  // www to the apex (see DECISIONS.md); headers come from public/_headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specstride-site",
  "compatibility_date": "2026-09-30",
  "main": "worker/index.js",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": true,
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "specstride.ai", "custom_domain": true },
    { "pattern": "www.specstride.ai", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
