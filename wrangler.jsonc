{
  // Static site on Workers with static assets. No Worker code: the www → apex
  // redirect is a zone Redirect Rule, and headers come from public/_headers.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "specstride-site",
  "compatibility_date": "2026-09-30",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  "routes": [
    { "pattern": "specstride.ai", "custom_domain": true },
    { "pattern": "www.specstride.ai", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false
}
