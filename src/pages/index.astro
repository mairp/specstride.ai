---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AsciiArt from '../components/AsciiArt.astro';
import InstallTabs from '../components/InstallTabs.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import Section from '../components/Section.astro';
import HarnessGrid from '../components/HarnessGrid.astro';
import Terminal from '../components/Terminal.astro';
import FAQ from '../components/FAQ.astro';
import Glow from '../components/Glow.astro';
import { SITE } from '../lib/site';
import { repoFacts } from '../lib/github';

const facts = await repoFacts();
const install = await getCollection('install');

// The README's four steps, one phase of a Spec Kit feature at a time.
const steps = [
  <>The implementer works through the phase's tasks.</>,
  <>The engine runs the tests itself.</>,
  <>The reviewer — a separate session, with no tools — reads the actual change against the tasks and answers with a one-time nonce.</>,
  <>Approved: tasks ticked, one commit, signed record. Rejected: back to the implementer with the reasons, up to 3 attempts.</>,
];

// The README's five bullets under "Built for unattended work".
const why = [
  { title: 'Kill the engine mid-run, nothing survives', body: <>SIGKILL the engine in the middle of a phase and no engine process is left running. Start it again and the run picks up where it stopped.</> },
  { title: 'Approved means committed', body: <>Every approved phase becomes its own commit. If a commit is blocked, the run never reports success: the engine exits 1 and says so.</> },
  { title: 'A clean stop', body: <>The <code>stop</code> verb of the <code>specstride</code> CLI that the plugin bundles ends the run at the next safe boundary: the workers finish their pass, the merge check runs, the record closes whole, no survivor.</> },
  { title: 'A reviewer from any provider', body: <>The reviewer can come from any provider your DeepSeek Harness (<code>dsh</code>) reaches.</> },
  { title: 'Secrets held back', body: <>Credentials are redacted from what the reviewer reads, and a credential in the change blocks the commit.</> },
];

// Sections are numbered in the order they render.
const order = ['loop', 'why', 'demo', 'agents', 'units', 'open-source', 'faq'];
const no = (id: string) => String(order.indexOf(id) + 1).padStart(2, '0');
const heroLede =
  'An agent that grades its own work says "done" when it isn\'t. Specstride is a Claude Code plugin that takes a Spec Kit feature to done, phase by phase, unattended: implement, verify, review, commit, resume. A separate reviewer must approve each phase before the run moves on, and every approval leaves a signed record and its own commit.';
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <Glow />
    <div class="wrap hero-grid">
      <div class="hero-head">
        <p class="oss mono">Open source <span aria-hidden="true">·</span> Runs on your machine <span aria-hidden="true">·</span> Your models, your keys</p>
        <h1 id="hero-title"><span class="line">{SITE.tagline}</span> <span class="line caption">{SITE.caption}</span></h1>
      </div>
      <div class="hero-body">
        <p class="lede">{heroLede}</p>
        <p class="ctas">
          <a class="btn" href={SITE.repoUrl}>GitHub{facts.stars !== null && <span class="muted"> ★ {facts.stars}</span>}</a>
          <a class="btn btn-primary" href="#install">Install <span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <section class="install-band" id="install" aria-labelledby="install-title">
    <div class="wrap install-wrap">
      <h2 id="install-title" class="visually-hidden">Install</h2>
      <InstallTabs entries={install} id="home-install" />
      <p class="more mono"><a href="/install/">Prerequisites and the first run →</a></p>
    </div>
  </section>

  <Section id="loop" eyebrow={`${no('loop')} · how it works`} title="How it works" intro="For each phase of a Spec Kit feature, the same gate:">
    <ol class="steps">
      {steps.map((s) => <li class="reveal">{s}</li>)}
    </ol>
    <LoopDiagram />
  </Section>

  <Section id="why" eyebrow={`${no('why')} · unattended`} title="Built for unattended work" tone="raised" intro="For people who leave agents running on real work and need to trust the result when they come back.">
    <div class="pin">
      <div class="pin-figure"><AsciiArt /></div>
      <div class="pin-cards why">
        {why.map((w) => (
          <div class="card reveal">
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section id="demo" eyebrow={`${no('demo')} · see it run`} title="See it run" intro="The example repository is a tiny Node project with one Spec Kit feature, in three phases, nothing implemented yet — Specstride does that, one reviewed and committed phase at a time.">
    <figure class="demo">
      <video data-demo autoplay muted loop playsinline preload="none" poster="/media/demo-poster.png" width="1010" height="692" aria-label="A Specstride run on the example repository: three phases implemented, tested, reviewed and committed">
        <source src="/media/demo.webm" type="video/webm" />
        <source src="/media/demo.mp4" type="video/mp4" />
      </video>
      <figcaption class="muted">
        A real run on <a href={SITE.exampleUrl}>the example repository</a>, sped up (waits capped at 1.5&nbsp;s, paths shortened). In phase 3 the two <code>[P]</code> tasks ran as a parallel group; the merge check caught a test one worker wrote for a framework the project does not use, so the engine redid both tasks in order before the reviewer saw the phase.
      </figcaption>
    </figure>
  </Section>

  <Section id="agents" eyebrow={`${no('agents')} · your models, your keys`} title="Your models, your keys" intro="Choose the implementer and the reviewer independently, on any provider and model your DeepSeek Harness (dsh) reaches. By default both are separate Claude sessions.">
    <HarnessGrid />
    <Terminal title="either role, on any provider dsh reaches" label="The environment variables that pick the implementer and the reviewer" class="env">
      <pre><span class="muted"># any provider and model your dsh reaches, either role</span>{'\n'}SPECSTRIDE_PROPOSER=dsh:&lt;provider&gt;/&lt;model&gt;{'\n'}SPECSTRIDE_CRITIC=dsh:&lt;provider&gt;/&lt;model&gt;</pre>
    </Terminal>
    <p class="afternote muted">The loop stays the same whichever you choose: same gates, same records, same commits.</p>
  </Section>

  <Section id="units" eyebrow={`${no('units')} · parallel units, opt-in`} title="Parallel units, opt-in" tone="raised" intro="Mark tasks [P] in your Spec Kit tasks.md and turn the layer on. Tasks whose files are disjoint run at once, each in its own worker tree, and the project's files are untouched while they run. The engine merges their work and runs the phase's checks before the reviewer sees the phase; tasks whose files overlap are refused, with the reason printed, and run in order.">
    <Terminal title="~/.config/specstride/config.yaml" label="The user configuration that turns parallel units on">
      <pre><span class="muted"># your user configuration, read from this file only</span>{'\n'}loop:{'\n'}  parallel:{'\n'}    units: on{'\n'}    allow_detect: on</pre>
    </Terminal>
    <p class="afternote muted">Groups run only when the implementer runs on dsh, the one harness whose concurrent sessions are tested; with any other harness the layer stays off and the run continues in order.</p>
  </Section>

  <Section id="open-source" eyebrow={`${no('open-source')} · open source`} title="Where your code goes">
    <div class="grid grid-3">
      <div class="card card-top">
        <h3>Apache-2.0</h3>
        <p>The whole product, free and open source under the Apache licence.</p>
        <p><a href={SITE.licenseUrl}>Read the licence</a></p>
      </div>
      <div class="card card-top">
        <h3>Runs on your machine</h3>
        <p>No service of its own: nothing is sent to Specstride's authors. Run records, approvals and logs stay in <code>~/.specstride/</code> on your machine, and telemetry export is off by default.</p>
      </div>
      <div class="card card-top">
        <h3>Your models, your keys</h3>
        <p>The implementer and the reviewer go through your Claude Code login by default, or through the provider you set with dsh. Each provider's own data policy applies.</p>
      </div>
    </div>
    <p class="ctas">
      <a class="btn" href={SITE.repoUrl}>Star or fork on GitHub</a>
      <a class="btn" href={SITE.exampleUrl}>Example</a>
      <a class="btn" href={SITE.contributingUrl}>Contributing</a>
    </p>
  </Section>

  <Section id="faq" eyebrow={`${no('faq')} · faq`} title="Questions" tone="raised">
    <FAQ />
  </Section>

  <section class="closing" aria-labelledby="closing-title">
    <Glow low />
    <div class="wrap">
      <h2 id="closing-title" class="reveal">{SITE.caption}</h2>
      <p class="lede reveal">Open source. Runs on your machine. Your models, your keys.</p>
      <p class="ctas reveal">
        <a class="btn" href={SITE.repoUrl}>GitHub</a>
        <a class="btn btn-primary" href="/install/">Install <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Hero: headline left, pitch right, the orb rising from the bottom edge. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: calc(100svh - 60px);
    padding: clamp(3rem, 11vh, 7.5rem) 0 15rem;
  }
  .hero-grid { display: grid; gap: var(--space-6); text-align: center; }
  .oss { color: var(--accent); font-size: var(--step--1); margin-bottom: var(--space-5); }
  h1 { margin: 0; font-size: var(--step-5); line-height: 1.08; letter-spacing: -0.03em; }
  .line { display: block; }
  .caption { color: var(--muted); }
  .hero-body .lede { font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.3125rem); color: var(--fg); margin: 0 auto; max-width: 40rem; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .hero .ctas, .closing .ctas { justify-content: center; }
  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-7); text-align: left; align-items: start; }
    .hero-body { padding-top: calc(var(--step--1) * 1.6 + var(--space-5) + 0.6rem); }
    .hero-body .lede { margin: 0; }
    .hero .ctas { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .oss, .line { animation: from-left 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .line { animation-delay: 0.12s; }
    .caption { animation-delay: 0.28s; }
    .hero-body > * { animation: from-right 1s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both; }
    .hero-body .ctas { animation-delay: 0.6s; }
  }
  @keyframes from-left { from { opacity: 0; translate: -3rem 0; } }
  @keyframes from-right { from { opacity: 0; translate: 3rem 0; } }

  .install-band { padding: var(--space-8) 0; }
  .install-wrap { max-width: 60rem; }
  .more { font-size: var(--step--1); margin-top: var(--space-4); }

  /* The four steps of a phase. */
  .steps { margin: 0 0 var(--space-7); padding: 0; list-style: none; display: grid; gap: var(--space-3); max-width: 52rem; counter-reset: step; }
  .steps li { counter-increment: step; display: flex; gap: var(--space-4); align-items: baseline; }
  .steps li::before { content: counter(step, decimal-leading-zero); font-family: var(--font-mono); color: var(--accent); flex: none; }

  /* Why: the mark stays put on the left while the cards scroll past. */
  .pin { display: grid; gap: var(--space-7); }
  .pin-figure { position: relative; isolation: isolate; justify-self: center; --art-size: clamp(7px, 0.82vw, 11px); --art-phone-size: clamp(16px, 5vw, 22px); }
  .pin-figure::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--orb-edge) 38%, transparent), transparent);
    filter: blur(30px);
  }
  .pin-cards { display: grid; gap: var(--space-5); }
  .why .card {
    background:
      linear-gradient(to right, color-mix(in srgb, var(--card-bg) 50%, transparent), var(--card-bg) 75%) padding-box,
      radial-gradient(circle, var(--dot) 1px, transparent 1.5px) 0 0 / 12px 12px padding-box,
      linear-gradient(var(--card-bg), var(--card-bg)) padding-box,
      linear-gradient(to right, color-mix(in srgb, var(--accent) var(--edge), transparent), color-mix(in srgb, var(--border) 55%, transparent) 72%) border-box;
  }
  .why p { margin: 0; }
  @media (min-width: 900px) {
    .pin { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); align-items: start; }
    .pin-figure { position: sticky; top: 22vh; justify-self: start; margin: var(--space-6) 0 var(--space-6) var(--space-5); }
  }

  /* See it run: the demo of the example repository. */
  .demo { margin: 0; display: grid; gap: var(--space-4); }
  .demo video { width: 100%; height: auto; border: 1px solid var(--border); border-radius: 10px; background: var(--surface); }
  .demo figcaption { font-size: 0.9375rem; max-width: 56rem; }
  @media (prefers-reduced-motion: reduce) { .demo video { animation: none; } }

  .env { max-width: 44rem; }
  .afternote { font-size: 0.9375rem; max-width: 52rem; margin: var(--space-4) 0 0; }

  .closing { position: relative; isolation: isolate; text-align: center; padding: var(--space-9) 0 13rem; }
  .closing h2 { font-size: var(--step-5); letter-spacing: -0.03em; }
  .closing .lede { margin: 0 auto; color: var(--muted); }
</style>

<script>
  // The demo plays on its own; under prefers-reduced-motion it never starts
  // without a click, and it yields when off screen.
  for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-demo]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) {
      video.removeAttribute('autoplay');
      video.pause();
      continue;
    }
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: 0.3 });
    io.observe(video);
  }
</script>
