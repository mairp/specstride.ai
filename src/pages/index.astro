<script>
  // The demo never loads until it is on screen and plays only while it is.
  // Without JavaScript, or under prefers-reduced-motion, it keeps its controls
  // and never starts on its own.
  for (const video of document.querySelectorAll<HTMLVideoElement>('video[data-demo]')) {
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) continue;
    video.controls = false;
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) video.play().catch(() => {});
        else video.pause();
      }
    }, { threshold: 0.3 });
    io.observe(video);
  }
</script>
