---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import AsciiArt from '../components/AsciiArt.astro';
import InstallTabs from '../components/InstallTabs.astro';
import LoopDiagram from '../components/LoopDiagram.astro';
import Section from '../components/Section.astro';
import HarnessGrid from '../components/HarnessGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import Terminal from '../components/Terminal.astro';
import FAQ from '../components/FAQ.astro';
import Glow from '../components/Glow.astro';
import { SITE, isAvailable } from '../lib/site';
import { repoFacts } from '../lib/github';
import { SAMPLE_EVENT } from '../data/demo-timeline';

const facts = await repoFacts();
const install = (await getCollection('install')).filter(isAvailable);
const products = (await getCollection('products')).filter(isAvailable).sort((a, b) => a.data.order - b.data.order);
const engines = products.filter((p) => p.data.kind === 'core');
const plugins = products.filter((p) => p.data.kind === 'plugin');

// What the loop adds to a plain retry loop, as the product README describes it.
const why = [
  { title: 'Fresh context, every pass', body: 'Each pass is a new, stateless session that works until the phase\'s evidence file exists. Only what is on disk carries over.' },
  { title: 'A critic that reads the code', body: 'The critic checks the evidence against the acceptance criteria, then reads the files it cites in a read-only pass. A reply it can\'t parse counts as a rejection.' },
  { title: 'Diagnose, then fix only what failed', body: 'The diagnostician reads the whole rejection history and says whether the gap is real. The accelerator fixes those criteria and leaves approved work untouched.' },
  { title: 'Self-tuning, with rollback', body: 'Per-phase budgets learned from telemetry, judged against their baseline after every approved phase, and reverted automatically when a guardrail breaks.' },
  { title: 'Halts safely, resumes from files', body: 'After a bounded number of rejections the run stops with exit code 2 and leaves everything on disk, readable and resumable from the files alone.' },
];

// Sections are numbered in the order they render; the plugins band appears with
// the first released plugin.
const order = ['loop', 'why', 'agents', ...(plugins.length > 0 ? ['plugins'] : []), 'observability', 'built-by-itself', 'open-source', 'faq'];
const no = (id: string) => String(order.indexOf(id) + 1).padStart(2, '0');
---
<Base>
  <section class="hero" aria-labelledby="hero-title">
    <Glow />
    <div class="wrap hero-grid">
      <div class="hero-head">
        <p class="oss mono">Open source <span aria-hidden="true">·</span> Runs on your machine <span aria-hidden="true">·</span> Your models, your keys</p>
        <h1 id="hero-title"><span class="line">{SITE.tagline}</span> <span class="line caption">{SITE.caption}</span></h1>
      </div>
      <div class="hero-body">
        <p class="lede">Specstride drives your coding agent through a Spec Kit feature, phase by phase. Nothing advances until a critic approves it on cited evidence. When a phase is stuck, a diagnostician finds out why and an accelerator fixes only what failed.</p>
        <p class="ctas">
          <a class="btn" href={SITE.repoUrl}>GitHub{facts.stars !== null && <span class="muted"> ★ {facts.stars}</span>}</a>
          <a class="btn btn-primary" href="#install">Install <span class="arrow" aria-hidden="true">→</span></a>
        </p>
      </div>
    </div>
  </section>

  <section class="install-band" id="install" aria-labelledby="install-title">
    <div class="wrap install-wrap">
      <h2 id="install-title" class="visually-hidden">Install</h2>
      <InstallTabs entries={install} id="home-install" />
      <p class="more mono"><a href="/install/">Prerequisites and every install path →</a></p>
    </div>
  </section>

  <Section id="loop" eyebrow={`${no('loop')} · the loop`} title="A gate on every phase" intro="The proposer works in fresh, stateless passes until the phase's evidence file exists. The critic reads the acceptance criteria, the evidence and the files it cites, then approves or rejects. A rejection with new unmet criteria goes to the diagnostician; its hint drives a narrowed retry that touches only what failed.">
    <LoopDiagram />
  </Section>

  <Section id="why" eyebrow={`${no('why')} · why`} title="What it adds to a plain agent loop" tone="raised">
    <p class="lede evidence">A plain retry loop starts a rejected phase again from scratch, so a stuck phase can burn pass after pass and learn nothing new. On one real 12-task phase, a full retry had spent 16 minutes re-deriving what turned out to be a two-file fix.</p>
    <div class="pin">
      <div class="pin-figure"><AsciiArt /></div>
      <div class="pin-cards why">
        {why.map((w) => (
          <div class="card reveal">
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </Section>

  <Section id="agents" eyebrow={`${no('agents')} · bring your own agents`} title="Any agent writes, any agent judges" intro="The proposer and the critic are chosen independently, so a cheap model can write while a stronger one judges.">
    <HarnessGrid />
    <p class="more mono"><a href="/ecosystem/">Roles in detail →</a></p>
  </Section>

  {plugins.length > 0 && (
    <Section id="plugins" eyebrow={`${no('plugins')} · hosts and plugins`} title="One engine, several front doors" intro="The engine runs detached. Hosts reach it through one CLI protocol, so a plugin is a thin layer of skills over it." tone="raised">
      <div class="bracket">
        <h3 class="bracket-title">Engine</h3>
        <div class:list={['grid', 'products', { 'grid-2': engines.length > 1 }]}>
          {engines.map((p) => <ProductCard product={p} showSkills={false} headingLevel="h4" />)}
        </div>
      </div>
      <div class="bracket">
        <h3 class="bracket-title">Plugins</h3>
        <div class="grid grid-3 products">
          {plugins.map((p) => <ProductCard product={p} headingLevel="h4" />)}
        </div>
      </div>
    </Section>
  )}

  <Section id="observability" eyebrow={`${no('observability')} · observability`} title="Every step is an event" intro="A run is a stream of structured events in .specstride/events.jsonl. The live presenter renders it in your terminal; the same stream ships to Loki or over OTLP to an OpenTelemetry collector, with cost, tokens and duration as metrics.">
    <div class="grid grid-2 obs">
      <Terminal title="events.jsonl · one record from the recorded run" label="An event record">
        <pre class="wrap-pre">{SAMPLE_EVENT}</pre>
      </Terminal>
      <Terminal title="mixture-of-loops · the last line of a run" label="The digest line">
        <pre class="wrap-pre"><span class="muted"># format, as printed by the launcher</span>{'\n'}[DIGEST] state=completed exit=0 last-stage=&lt;stage&gt; evidence=&lt;run dir&gt;</pre>
      </Terminal>
    </div>
    <ul class="obs-list">
      <li><code>--otel --otel-url http://localhost:4318</code> ships OTLP/HTTP with no SDK; <code>--telemetry</code> ships to Loki. Off by default.</li>
      <li><code>[DIGEST]</code> is the one line a supervising agent reads at the end of a run: state, exit code, last stage, evidence. Today it comes from the <a href="https://github.com/mairp/mixture-of-loops">mixture-of-loops</a> launcher.</li>
    </ul>
  </Section>

  <Section id="built-by-itself" eyebrow={`${no('built-by-itself')} · built by itself`} title="It is building its own next version" tone="raised">
    <div class="grid grid-2 self">
      <div>
        <p>Specstride's TypeScript core was specified first: 41 Spec Kit features, 1,643 functional requirements, 2,983 tasks, and a parity suite the port has to pass against today's CLI.</p>
        <p>Since 30 September 2026 the CLI has been implementing those features unattended, one at a time, each phase held at the gate until its critic approved it. A human reads the result and arbitrates only what the machines can't settle.</p>
      </div>
      <Terminal title="git log --oneline · the TypeScript core, 1 Oct 2026" label="Recent commits in the TypeScript core">
        <pre class="wrap-pre">specstride: phase 7 approved — User Story 5 - A consumer invokes a host skill
specstride: phase 6 approved — User Story 4 - An author describes a harness as data
specstride: phase 5 approved — User Story 3 - An author adds an implementation without touching the core
specstride: phase 4 approved — User Story 2 - An operator reads an exit code and a stop reason</pre>
      </Terminal>
    </div>
  </Section>

  <Section id="open-source" eyebrow={`${no('open-source')} · open source`} title="Yours to run, read and change">
    <div class="grid grid-3">
      <div class="card card-top">
        <h3>Apache-2.0</h3>
        <p>The whole product. A patent grant from every contributor, contributions taken under the same licence with no CLA, and the Specstride name kept for the project.</p>
        <p><a href={SITE.licenseUrl}>Read the licence</a></p>
      </div>
      <div class="card card-top">
        <h3>Runs on your machine</h3>
        <p>No service in the middle. Runs, state and logs live under <code>.specstride/</code> in your project, readable and resumable from the files alone.</p>
      </div>
      <div class="card card-top">
        <h3>Your models, your keys</h3>
        <p>It calls the agents and providers you configure, with your credentials, and nothing else. Telemetry stays off until you point it at your own collector.</p>
      </div>
    </div>
    <p class="ctas">
      <a class="btn" href={SITE.repoUrl}>Star or fork on GitHub</a>
      <a class="btn" href={SITE.discussionsUrl}>Discussions</a>
      <a class="btn" href="https://github.com/mairp/specstride/blob/main/CONTRIBUTING.md">Contributing</a>
    </p>
  </Section>

  <Section id="faq" eyebrow={`${no('faq')} · faq`} title="Questions" tone="raised">
    <FAQ />
  </Section>

  <section class="closing" aria-labelledby="closing-title">
    <Glow low />
    <div class="wrap">
      <h2 id="closing-title" class="reveal">{SITE.caption}</h2>
      <p class="lede reveal">Open source. Runs on your machine. Your models, your keys.</p>
      <p class="ctas reveal">
        <a class="btn" href={SITE.repoUrl}>GitHub</a>
        <a class="btn btn-primary" href="/install/">Install <span class="arrow" aria-hidden="true">→</span></a>
      </p>
    </div>
  </section>
</Base>

<style>
  /* Hero: headline left, pitch right, the orb rising from the bottom edge. */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: clip;
    min-height: calc(100svh - 60px);
    padding: clamp(3rem, 11vh, 7.5rem) 0 15rem;
  }
  .hero-grid { display: grid; gap: var(--space-6); text-align: center; }
  .oss { color: var(--accent); font-size: var(--step--1); margin-bottom: var(--space-5); }
  h1 { margin: 0; font-size: var(--step-5); line-height: 1.08; letter-spacing: -0.03em; }
  .line { display: block; }
  .caption { color: var(--muted); }
  .hero-body .lede { font-size: clamp(1.0625rem, 0.9rem + 0.6vw, 1.3125rem); color: var(--fg); margin: 0 auto; max-width: 40rem; }
  .ctas { display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-3); margin: var(--space-6) 0 0; }
  .hero .ctas, .closing .ctas { justify-content: center; }
  @media (min-width: 960px) {
    .hero-grid { grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr); gap: var(--space-7); text-align: left; align-items: start; }
    .hero-body { padding-top: calc(var(--step--1) * 1.6 + var(--space-5) + 0.6rem); }
    .hero-body .lede { margin: 0; }
    .hero .ctas { justify-content: flex-start; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .oss, .line { animation: from-left 1s cubic-bezier(0.16, 1, 0.3, 1) both; }
    .line { animation-delay: 0.12s; }
    .caption { animation-delay: 0.28s; }
    .hero-body > * { animation: from-right 1s cubic-bezier(0.16, 1, 0.3, 1) 0.45s both; }
    .hero-body .ctas { animation-delay: 0.6s; }
  }
  @keyframes from-left { from { opacity: 0; translate: -3rem 0; } }
  @keyframes from-right { from { opacity: 0; translate: 3rem 0; } }

  .install-band { padding: var(--space-8) 0; }
  .install-wrap { max-width: 60rem; }
  .more { font-size: var(--step--1); margin-top: var(--space-4); }

  /* Why: the mark stays put on the left while the cards scroll past. */
  .evidence { margin-bottom: var(--space-7); max-width: 52rem; }
  .pin { display: grid; gap: var(--space-7); }
  .pin-figure { position: relative; isolation: isolate; justify-self: center; --art-size: clamp(7px, 0.82vw, 11px); --art-phone-size: clamp(16px, 5vw, 22px); }
  .pin-figure::before {
    content: '';
    position: absolute;
    inset: -12% -8%;
    z-index: -1;
    border-radius: 50%;
    background: radial-gradient(closest-side, color-mix(in srgb, var(--orb-edge) 38%, transparent), transparent);
    filter: blur(30px);
  }
  .pin-cards { display: grid; gap: var(--space-5); }
  .why .card {
    background:
      linear-gradient(to right, color-mix(in srgb, var(--card-bg) 50%, transparent), var(--card-bg) 75%) padding-box,
      radial-gradient(circle, var(--dot) 1px, transparent 1.5px) 0 0 / 12px 12px padding-box,
      linear-gradient(var(--card-bg), var(--card-bg)) padding-box,
      linear-gradient(to right, color-mix(in srgb, var(--accent) var(--edge), transparent), color-mix(in srgb, var(--border) 55%, transparent) 72%) border-box;
  }
  .why p { margin: 0; }
  @media (min-width: 900px) {
    .pin { grid-template-columns: minmax(0, 1fr) minmax(0, 27rem); align-items: start; }
    .pin-figure { position: sticky; top: 22vh; justify-self: start; margin: var(--space-6) 0 var(--space-6) var(--space-5); }
  }

  .products { align-items: stretch; }
  .obs { margin-bottom: var(--space-5); }
  .wrap-pre { white-space: pre-wrap !important; overflow-wrap: anywhere; }
  .obs-list { display: grid; gap: var(--space-3); color: var(--muted); max-width: 56rem; }
  .obs-list li::marker { color: var(--accent); }
  .self { align-items: start; }

  .closing { position: relative; isolation: isolate; text-align: center; padding: var(--space-9) 0 13rem; }
  .closing h2 { font-size: var(--step-5); letter-spacing: -0.03em; }
  .closing .lede { margin: 0 auto; color: var(--muted); }
</style>
