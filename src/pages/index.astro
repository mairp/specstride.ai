  /* Loop engineering: the nested loops beside the principles. */
  .eng { display: grid; gap: var(--space-6); margin-top: var(--space-7); }
  .eng-cards { display: grid; gap: var(--space-4); }
  .eng-cards p, .controls p, .guarantees p:last-child { margin: 0; }
