---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import HarnessGrid from '../components/HarnessGrid.astro';
import ProductCard from '../components/ProductCard.astro';
import { isAvailable } from '../lib/site';

const products = (await getCollection('products')).filter(isAvailable).sort((a, b) => a.data.order - b.data.order);
const hosts = (await getCollection('hosts')).sort((a, b) => a.data.order - b.data.order);
const byHost = hosts
  .map((h) => ({ host: h, products: products.filter((p) => p.data.host?.id === h.id) }))
  .filter((h) => h.products.length > 0);
const core = products.filter((p) => p.data.kind === 'core');
const plugins = products.filter((p) => p.data.kind === 'plugin');
---
<Base title="Ecosystem" description="Specstride's products, where they run and the agents they drive.">
  <div class="wrap page">
    <p class="eyebrow mono">// ecosystem</p>
    <h1>Ecosystem</h1>
    <p class="lede">What Specstride ships, where it runs, and the agents it drives.</p>

    <h2>Products</h2>
    <div class="bracket">
      <h3 class="bracket-title">Engine</h3>
      <div class:list={['grid', { 'grid-2': core.length > 1 }]}>{core.map((p) => <ProductCard product={p} headingLevel="h4" />)}</div>
    </div>
    {plugins.length > 0 && (
      <div class="bracket">
        <h3 class="bracket-title">Plugins</h3>
        <div class="grid grid-3">{plugins.map((p) => <ProductCard product={p} headingLevel="h4" />)}</div>
      </div>
    )}

    {byHost.length > 1 && (
      <>
        <h2 class="gap">Hosts</h2>
        <div class="table-scroll">
          <table>
            <caption class="visually-hidden">Hosts and the Specstride products for each</caption>
            <thead><tr><th scope="col">Host</th><th scope="col">Product</th><th scope="col">Notes</th></tr></thead>
            <tbody>
              {byHost.map(({ host, products }) => products.map((p, i) => (
                <tr>
                  {i === 0 && <th scope="row" rowspan={products.length}>{host.data.url ? <a href={host.data.url}>{host.data.name}</a> : host.data.name}</th>}
                  <td><a href={`/products/${p.id}/`}>{p.data.name}</a></td>
                  <td>{host.data.blurb}</td>
                </tr>
              )))}
            </tbody>
          </table>
        </div>
      </>
    )}

    <h2 class="gap">Agents</h2>
    <p class="muted">The proposer is the coding agent; the critic is the judge. They are picked independently, with <code>SPECSTRIDE_PROPOSER</code> and <code>SPECSTRIDE_CRITIC</code>, so a cheap model can write while a stronger one judges.</p>
    <HarnessGrid />
  </div>
</Base>

<style>
  .page { padding-top: var(--space-7); }
  .eyebrow { color: var(--accent); font-size: var(--step--1); margin-bottom: var(--space-2); }
  .lede { margin-bottom: var(--space-6); color: var(--muted); }
  .gap { margin-top: var(--space-8); }
</style>
