---
// One page per product, generated from src/content/products/. The front matter
// fills the page; the Markdown body, if any, is added as prose.
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import InstallTabs from '../../components/InstallTabs.astro';
import { inlineMd } from '../../lib/inline-md';
import { isAvailable } from '../../lib/site';

export async function getStaticPaths() {
  const products = (await getCollection('products')).filter(isAvailable);
  return products.map((p) => ({ params: { id: p.id }, props: { product: p } }));
}
const { product } = Astro.props;
const d = product.data;
const host = d.host ? await getEntry(d.host) : undefined;
const install = d.install ? await getEntry(d.install) : undefined;
const { Content } = await render(product);
const all = (await getCollection('products')).filter(isAvailable).sort((a, b) => a.data.order - b.data.order);
const engine = all.find((v) => v.data.kind === 'core');
const hostsBuilt = all.filter((v) => v.data.builtOn);
const base = d.builtOn ? await getEntry(d.builtOn) : undefined;
const builtHere = hostsBuilt.filter((v) => v.data.builtOn?.id === product.id);
const repoName = d.repo?.replace('https://github.com/', '');
const coreRepo = base?.data.repo;
---
<Base title={d.name} description={d.summary.replace(/`/g, '')}>
  <div class="wrap page">
    <nav class="variants mono" aria-label="Engine and hosts">
      {engine && <><span class="group">engine</span><a href={`/products/${engine.id}/`} aria-current={engine.id === product.id ? 'page' : undefined}>{engine.data.name}</a></>}
      <span class="group">hosts</span>
      {hostsBuilt.map((v) => <a href={`/products/${v.id}/`} aria-current={v.id === product.id ? 'page' : undefined}>{v.data.name}</a>)}
      <a class="all" href="/#ways">Compare the hosts →</a>
    </nav>
    {base && <p class="crumb mono"><a href={`/products/${base.id}/`}>{base.data.name}</a> <span aria-hidden="true">›</span> <span class="sr">built on it: </span>{d.name} <span class="muted">· {d.relation}</span></p>}
    <p class="eyebrow mono">// {d.kind === 'plugin' ? 'host' : 'the foundation'}{host && host.id !== 'shell' ? ` · ${host.data.name}` : ''}</p>
    <h1>{d.name}</h1>
    <p class="lede" set:html={inlineMd(d.summary)} />
    <p class="muted">{d.statusNote}</p>
    <div class="prose"><Content /></div>

    {builtHere.length > 0 && (
      <section aria-labelledby="built-on">
        <h2 id="built-on">Hosts built on it</h2>
        <ul class="built">
          {builtHere.map((h) => <li><a href={`/products/${h.id}/`}>{h.data.name}</a> <span class="muted">— {h.data.relation}</span></li>)}
        </ul>
      </section>
    )}

    {d.skills.length > 0 && (
      <section aria-labelledby="skills">
        <h2 id="skills">{d.kind === 'plugin' ? 'Skills' : 'Commands'}</h2>
        <dl class="skills">
          {d.skills.map((s) => (<><dt><code>{s.name}</code></dt><dd set:html={inlineMd(s.does)} /></>))}
        </dl>
      </section>
    )}

    {install && (
      <section aria-labelledby="install">
        <h2 id="install">Install</h2>
        <InstallTabs entries={[install]} full id={`p-${product.id}`} star={false} />
      </section>
    )}

    {(d.repo || d.links.length > 0) && (
      <p class="links">
        {d.repo && <a class="btn" href={d.repo}>Repository</a>}
        {d.repo && <a class="btn star" href={d.repo}><span aria-hidden="true">★ </span>Star {repoName} on GitHub</a>}
        {d.links.map((l) => <a class="btn" href={l.href}>{l.label}</a>)}
      </p>
    )}
    {d.repo && <p class="star-note muted">Useful? A star on <a href={d.repo}>{repoName}</a>{coreRepo && <> and on the engine, <a href={coreRepo}>{coreRepo.replace('https://github.com/', '')}</a>,</>} helps others find Specstride.</p>}
  </div>
</Base>

<style>
  .page { padding-top: var(--space-7); max-width: 56rem; }
  .variants { display: flex; flex-wrap: wrap; gap: var(--space-2); margin-bottom: var(--space-6); font-size: var(--step--1); }
  .variants a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 var(--space-4); border: 1px solid var(--border); border-radius: 999px; color: var(--fg); text-decoration: none; background: var(--card); }
  .variants a:hover { border-color: var(--accent); color: var(--fg-strong); }
  .variants a[aria-current='page'] { border-color: var(--accent); color: var(--fg-strong); background: color-mix(in srgb, var(--accent) 12%, var(--card)); }
  .variants .group { display: inline-flex; align-items: center; min-height: 44px; color: var(--muted); font-size: 0.6875rem; text-transform: uppercase; letter-spacing: 0.04em; }
  .variants .group:not(:first-child) { margin-left: var(--space-3); }
  .crumb { font-size: var(--step--1); margin: 0 0 var(--space-3); }
  .sr { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); }
  .built { padding-left: 1.2rem; }
  .star-note { margin-top: var(--space-3); font-size: 0.875rem; }
  .variants .all { border-color: transparent; background: none; color: var(--accent); padding: 0 var(--space-2); }
  .eyebrow { color: var(--accent); font-size: var(--step--1); margin-bottom: var(--space-2); }
  .lede { margin: var(--space-5) 0 var(--space-3); }
  .prose :global(pre) { overflow-x: auto; max-width: 100%; padding: var(--space-4); background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); font-size: 0.8125rem; line-height: 1.5; }
  .prose :global(h2) { font-size: var(--step-2); margin-top: var(--space-7); }
  section { margin-top: var(--space-7); }
  .skills { display: grid; gap: var(--space-2) var(--space-5); grid-template-columns: max-content 1fr; }
  @media (max-width: 640px) { .skills { grid-template-columns: 1fr; } .skills dd { margin-bottom: var(--space-3); } }
  .skills dd { margin: 0; }
  .links { display: flex; flex-wrap: wrap; gap: var(--space-3); margin-top: var(--space-7); }
</style>
