---
// The hero art, generated from the mark by scripts/gen-ascii.mjs. Gate posts
// light up in the order a run reaches them; the animation is off under
// prefers-reduced-motion. Phones get the mark itself, set larger.
import hero from '../generated/hero.json';
type Run = { t: string; g?: number | null };
interface Props { label?: string }
const { label = 'The Specstride mark: a track folded into an S, with gate posts along it.' } = Astro.props;
const lines = (rows: Run[][]) => rows;
---
<figure class="ascii" role="img" aria-label={label}>
  <pre class="art art-desktop" aria-hidden="true">{lines(hero.desktop as Run[][]).map((row) => (
    <>{row.map((r) => (typeof r.g === 'number' ? <span class={`gate g${r.g}`}>{r.t}</span> : r.t))}{'\n'}</>
  ))}</pre>
  <pre class="art art-phone" aria-hidden="true">{lines(hero.phone as Run[][]).map((row) => (
    <>{row.map((r) => (typeof r.g === 'number' ? <span class={`gate g${r.g}`}>{r.t}</span> : r.t))}{'\n'}</>
  ))}</pre>
</figure>

<style>
  .ascii { margin: 0; min-width: 0; }
  .art {
    font-family: var(--font-mono);
    color: var(--fg-strong);
    line-height: 1;
    white-space: pre;
    margin: 0;
    user-select: none;
    text-align: left;
    font-variant-ligatures: none;
  }
  /* 64 columns: size the font from the container so it never overflows */
  .art-desktop { display: none; font-size: clamp(8px, 1.1vw, 15px); line-height: 1.1; font-weight: 700; }
  .art-phone { font-size: clamp(22px, 7.4vw, 34px); line-height: 1.02; letter-spacing: -0.02em; }
  @media (min-width: 760px) {
    .art-desktop { display: block; }
    .art-phone { display: none; }
  }
  .art-desktop { color: color-mix(in srgb, var(--fg-strong) 88%, var(--accent)); }
  .gate { color: var(--muted); font-weight: 700; }
  @media (prefers-reduced-motion: no-preference) {
    .gate { animation: gate 9s infinite steps(1, end); }
    .g0 { animation-delay: 0.6s; }
    .g1 { animation-delay: 1.4s; }
    .g2 { animation-delay: 2.2s; }
    .g3 { animation-delay: 3s; }
    .g4 { animation-delay: 3.8s; }
    .g5 { animation-delay: 4.6s; }
  }
  @media (prefers-reduced-motion: reduce) {
    .g0, .g1, .g2 { color: var(--ok); }
    .g3 { color: var(--accent); }
  }
  @keyframes gate {
    0% { color: var(--accent); }
    8% { color: var(--ok); }
    80% { color: var(--ok); }
    100% { color: var(--muted); }
  }
</style>
