---
// One loop with no brakes beside the engineered loops. The left column says
// only what follows from the product READMEs' description of a plain agent
// session; the right column is the core README's "Why loop engineering".
// No figures. Each row carries its own labels, so it reads without the head.
const rows = [
  { q: 'How it ends', plain: 'It can end with "it went quiet".', eng: 'A named stop reason with a fixed exit code.' },
  { q: 'Who says "done"', plain: 'The agent that did the work.', eng: 'The tests first, then a separate reviewer.' },
  { q: 'What a retry is', plain: 'The same attempt again, with the same mistake.', eng: 'A diagnosis first, then an attempt narrowed to the unmet tasks.' },
  { q: 'Why a decision was made', plain: 'No rule to point to.', eng: 'A rule id and a table version on every decision.' },
  { q: 'What a kill costs', plain: 'The loop stops there.', eng: 'No engine process survives, and the next start resumes where it stopped.' },
];
---
<div class="cmp">
  <div class="cmp-row cmp-head mono" aria-hidden="true">
    <span></span>
    <span class="h">one loop, no brakes</span>
    <span class="h h-eng">engineered loops</span>
  </div>
  {rows.map((r) => (
    <div class="cmp-row reveal">
      <h3 class="q">{r.q}</h3>
      <p class="plain"><span class="tag mono">One loop: </span>{r.plain}</p>
      <p class="eng"><span class="tag mono">Engineered: </span>{r.eng}</p>
    </div>
  ))}
</div>

<style>
  .cmp { display: grid; border: 1px solid var(--border); border-radius: 12px; background: var(--card); overflow: hidden; }
  .cmp-row { display: grid; gap: var(--space-2); padding: var(--space-4) var(--space-5); border-top: 1px solid var(--border); }
  .cmp-head { display: none; }
  .cmp-row:nth-child(2) { border-top: 0; }
  .q { margin: 0; font-size: var(--step-0); font-weight: 500; }
  .cmp-row p { margin: 0; }
  .plain { color: var(--muted); }
  .eng { color: var(--fg); }
  .tag { font-size: 0.75rem; color: var(--muted); }
  .eng .tag { color: var(--accent); }
  @media (min-width: 760px) {
    .cmp-row { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr) minmax(0, 1.2fr); gap: var(--space-5); align-items: baseline; }
    .cmp-head { display: grid; border-top: 0; background: var(--surface); padding-block: var(--space-3); }
    .cmp-row:nth-child(2) { border-top: 1px solid var(--border); }
    .h { font-size: 0.75rem; letter-spacing: 0.04em; text-transform: uppercase; color: var(--muted); }
    .h-eng { color: var(--accent); }
    .tag { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; }
  }
</style>
