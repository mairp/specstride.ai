---
// The loop of the product README as an ASCII diagram. The stored log of a real
// run that used to replay beside it is the hero's figure now (HeroRun.astro).
// Boxes are found by their corners; the word inside names the node. Edge labels
// are matched by word. Both become spans the script can light up.
const WIDE = [
  '┌─────────────┐ the change ┌──────────────┐ test output ┌──────────┐ approved ┌──────────┐',
  '│ implementer │ ─────────▶ │ verification │ ──────────▶ │ reviewer │ ───────▶ │ approval │ ─▶ next phase',
  '└───▲─────▲───┘            └──────────────┘             └────┬─────┘          └──────────┘',
  '    │     │                                                  │ rejected · up to 3 attempts',
  '    │     │ narrowed retry    ┌─────────────┐  hint  ┌───────▼───────┐',
  '    │     └───────────────────│ accelerator │ ◀───── │ diagnostician │  new unmet tasks',
  '    │                         └─────────────┘        └───────┬───────┘',
  '    └────────────────────────────────────────────────────────┘ already diagnosed: back with the reasons',
];
const NARROW = [
  '┌─────────────┐',
  '│ implementer │ ◀────────────┐',
  '└──────┬──────┘              │ narrowed',
  '       │ the change          │ retry',
  '       ▼                     │',
  '┌──────────────┐      ┌──────┴──────┐',
  '│ verification │      │ accelerator │',
  '└──────┬───────┘      └──────▲──────┘',
  '       │ test output         │ hint',
  '       ▼                     │',
  '┌──────────┐ rejected ┌──────┴────────┐',
  '│ reviewer │ ───────▶ │ diagnostician │',
  '└────┬─────┘          └───────────────┘',
  '     │ approved',
  '     ▼',
  '┌──────────┐',
  '│ approval │ ─▶ next phase',
  '└──────────┘',
];
const EDGES: Record<string, string> = {
  'the change': 'implementer',
  'test output': 'verification',
  'approved': 'approval',
  'next phase': 'approval',
  'rejected': 'reject',
  'up to 3 attempts': 'reject',
  'already diagnosed': 'reject',
  'back with the reasons': 'reject',
  'new unmet tasks': 'diagnostician',
  'hint': 'diagnostician',
  'narrowed': 'accelerator',
  'retry': 'accelerator',
};

type Run = { t: string; n?: string };
function annotate(lines: string[]): Run[][] {
  const grid = lines.map((l) => [...l]);
  const owner = grid.map((row) => row.map(() => ''));
  grid.forEach((row, r) => row.forEach((ch, c) => {
    if (ch !== '┌') return;
    let c2 = c + 1; while (grid[r][c2] && grid[r][c2] !== '┐') c2++;
    let r2 = r + 1; while (grid[r2] && grid[r2][c] !== '└') r2++;
    const name = grid[r + 1].slice(c + 1, c2).join('').trim();
    for (let y = r; y <= r2; y++) for (let x = c; x <= c2; x++) if (grid[y]?.[x] !== undefined) owner[y][x] = name;
  }));
  grid.forEach((row, r) => {
    const s = row.join('');
    for (const [word, node] of Object.entries(EDGES)) {
      const i = s.indexOf(word);
      if (i >= 0 && !owner[r][i]) for (let x = i; x < i + word.length; x++) owner[r][x] = node;
    }
  });
  return grid.map((row, r) => {
    const runs: Run[] = [];
    row.forEach((ch, c) => {
      const n = owner[r][c] || undefined;
      const last = runs[runs.length - 1];
      if (last && last.n === n) last.t += ch; else runs.push({ t: ch, n });
    });
    return runs;
  });
}
const wide = annotate(WIDE);
const narrow = annotate(NARROW);
---
<figure class="diagram" aria-label="The loop: the implementer works through the phase's tasks; the engine runs the tests itself; the reviewer, a separate session with no tools, reads the actual change against the tasks. Approved: tasks ticked, one commit, a signed record, then the next phase. Rejected, up to 3 attempts: when the rejection names unmet tasks not diagnosed yet, the diagnostician writes a hint and the accelerator runs a narrowed retry; otherwise the phase goes back to the implementer with the reasons.">
  <pre class="d-wide" aria-hidden="true">{wide.map((row) => (<>{row.map((r) => (r.n ? <span data-node={r.n}>{r.t}</span> : r.t))}{'\n'}</>))}</pre>
  <pre class="d-narrow" aria-hidden="true">{narrow.map((row) => (<>{row.map((r) => (r.n ? <span data-node={r.n}>{r.t}</span> : r.t))}{'\n'}</>))}</pre>
</figure>


<style>
  .diagram { margin: 0; min-width: 0; overflow-x: auto; }
  .diagram pre { font-family: var(--font-mono); color: var(--muted); line-height: 1.3; margin: 0; font-variant-ligatures: none; }
  .d-wide { display: none; font-size: clamp(9px, 1.35vw, 15px); }
  .d-narrow { font-size: clamp(11px, 3.6vw, 15px); }
  @media (min-width: 760px) { .d-wide { display: block; } .d-narrow { display: none; } }
  .diagram [data-node] { color: var(--fg); }
  .diagram [data-node='approval'] { color: var(--ok); }
  .diagram [data-node='reject'] { color: var(--err); }
</style>
