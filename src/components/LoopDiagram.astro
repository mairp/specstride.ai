---
// The gated loop as an ASCII diagram beside a replay of a real run. The replay
// steps through the presenter transcript in src/data/demo-timeline.ts and lights
// up the part of the diagram each line belongs to. Under prefers-reduced-motion,
// or without JavaScript, the whole transcript is shown and nothing moves.
import Terminal from './Terminal.astro';
import { TIMELINE } from '../data/demo-timeline';

// Boxes are found by their corners; the word inside names the node. Edge labels
// are matched by word. Both become spans the script can light up.
const WIDE = [
  '┌──────────┐ evidence ┌────────┐ approved ┌────────────┐',
  '│ proposer │ ───────▶ │ critic │ ───────▶ │ checkpoint │ ─▶ next phase',
  '└──────────┘          └───┬────┘          └────────────┘',
  '      ▲                   │ rejected',
  '      │ retry             ▼',
  '┌─────┴───────┐ hint ┌───────────────┐',
  '│ accelerator │ ◀─── │ diagnostician │',
  '└─────────────┘      └───────────────┘',
];
const NARROW = [
  '┌──────────┐',
  '│ proposer │ ◀──────────┐',
  '└────┬─────┘            │ retry',
  '     │ evidence  ┌──────┴──────┐',
  '┌────▼───┐       │ accelerator │',
  '│ critic │       └──────▲──────┘',
  '└────┬───┘              │ hint',
  '     ├── rejected ─▶ ┌──┴────────────┐',
  '     │               │ diagnostician │',
  '     │ approved      └───────────────┘',
  '┌────▼───────┐',
  '│ checkpoint │ ─▶ next phase',
  '└────────────┘',
];
const EDGES: Record<string, string> = { evidence: 'evidence', approved: 'approve', rejected: 'reject', hint: 'diagnostician', retry: 'accelerator' };

type Run = { t: string; n?: string };
function annotate(lines: string[]): Run[][] {
  const grid = lines.map((l) => [...l]);
  const owner = grid.map((row) => row.map(() => ''));
  grid.forEach((row, r) => row.forEach((ch, c) => {
    if (ch !== '┌') return;
    let c2 = c + 1; while (grid[r][c2] && grid[r][c2] !== '┐') c2++;
    let r2 = r + 1; while (grid[r2] && grid[r2][c] !== '└') r2++;
    const name = grid[r + 1].slice(c + 1, c2).join('').trim();
    for (let y = r; y <= r2; y++) for (let x = c; x <= c2; x++) if (grid[y]?.[x] !== undefined) owner[y][x] = name;
  }));
  grid.forEach((row, r) => {
    const s = row.join('');
    for (const [word, node] of Object.entries(EDGES)) {
      const i = s.indexOf(word);
      if (i >= 0 && !owner[r][i]) for (let x = i; x < i + word.length; x++) owner[r][x] = node;
    }
  });
  return grid.map((row, r) => {
    const runs: Run[] = [];
    row.forEach((ch, c) => {
      const n = owner[r][c] || undefined;
      const last = runs[runs.length - 1];
      if (last && last.n === n) last.t += ch; else runs.push({ t: ch, n });
    });
    return runs;
  });
}
const wide = annotate(WIDE);
const narrow = annotate(NARROW);
---
<div class="loop" data-loop>
  <figure class="diagram" aria-label="The loop: the proposer writes evidence; the critic approves it, which checkpoints the phase, or rejects it, which sends the rejection to the diagnostician, whose hint drives a narrowed retry by the accelerator.">
    <pre class="d-wide" aria-hidden="true">{wide.map((row) => (<>{row.map((r) => (r.n ? <span data-node={r.n}>{r.t}</span> : r.t))}{'\n'}</>))}</pre>
    <pre class="d-narrow" aria-hidden="true">{narrow.map((row) => (<>{row.map((r) => (r.n ? <span data-node={r.n}>{r.t}</span> : r.t))}{'\n'}</>))}</pre>
  </figure>

  <Terminal title="specstride run · recorded demo, replayed" label="Replay of a recorded Specstride run">
    <button slot="actions" type="button" class="replay" data-replay hidden>Replay</button>
    <pre class="timeline" aria-live="off">{TIMELINE.map((l, i) => (
      <span class={`tl tone-${l.tone}`} data-step={i} data-node={l.node ?? ''}>{l.text}{'\n'}</span>
    ))}</pre>
  </Terminal>
  <p class="caption muted">A recorded run (the one the project README replays), rendered by the shipped presenter. Phase 3 is rejected, diagnosed, accelerated and approved.</p>
</div>

<style>
  .loop { display: grid; gap: var(--space-5); min-width: 0; }
  .diagram { margin: 0; min-width: 0; }
  .diagram pre { font-family: var(--font-mono); color: var(--muted); line-height: 1.3; margin: 0; font-variant-ligatures: none; }
  .d-wide { display: none; font-size: clamp(9px, 1.45vw, 15px); }
  .d-narrow { font-size: clamp(11px, 3.6vw, 15px); }
  @media (min-width: 720px) { .d-wide { display: block; } .d-narrow { display: none; } }
  [data-node] { transition: color 0.25s, text-shadow 0.25s; }
  .diagram [data-node] { color: var(--fg); }
  .diagram [data-node].lit { color: var(--accent); font-weight: 700; }
  .diagram [data-node='approve'].lit, .diagram [data-node='checkpoint'].lit { color: var(--ok); }
  .diagram [data-node='reject'].lit { color: var(--err); }
  .diagram [data-node='diagnostician'].lit { color: var(--warn); }
  .timeline { font-size: 0.78rem; }
  .tl { display: inline; }
  .tone-muted { color: var(--muted); }
  .tone-accent { color: var(--accent); }
  .tone-ok { color: var(--ok); }
  .tone-err { color: var(--err); }
  .tone-warn { color: var(--warn); }
  .tone-rail { color: var(--muted); }
  .tone-plain { color: var(--fg); }
  [data-playing] .tl { visibility: hidden; }
  [data-playing] .tl.shown { visibility: visible; }
  .tl.current { background: color-mix(in srgb, var(--accent) 14%, transparent); }
  .replay {
    font-family: var(--font-mono); font-size: 0.75rem; color: var(--muted); background: transparent;
    border: 1px solid var(--border); border-radius: 4px; padding: 0.3rem 0.6rem; cursor: pointer; min-height: 32px;
  }
  .replay:hover { color: var(--fg-strong); border-color: var(--accent); }
  .caption { font-size: var(--step--1); margin: 0; }
  @media (prefers-reduced-motion: reduce) { [data-node] { transition: none; } }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-loop]');
  if (root && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const lines = [...root.querySelectorAll<HTMLElement>('.tl')];
    const nodes = [...root.querySelectorAll<HTMLElement>('.diagram [data-node]')];
    const replay = root.querySelector<HTMLButtonElement>('[data-replay]')!;
    let timer: number | undefined;
    const light = (node: string) => nodes.forEach((n) => n.classList.toggle('lit', !!node && n.dataset.node === node));
    const stop = () => { if (timer) clearTimeout(timer); timer = undefined; };
    const play = () => {
      stop();
      root.dataset.playing = '';
      lines.forEach((l) => l.classList.remove('shown', 'current'));
      let i = 0;
      const step = () => {
        lines.forEach((l) => l.classList.remove('current'));
        if (i >= lines.length) { light(''); delete root.dataset.playing; return; }
        const line = lines[i];
        line.classList.add('shown', 'current');
        light(line.dataset.node ?? '');
        const rail = line.classList.contains('tone-rail');
        i++;
        timer = window.setTimeout(step, rail ? 120 : 900);
      };
      step();
    };
    replay.hidden = false;
    replay.addEventListener('click', play);
    const io = new IntersectionObserver((entries) => {
      if (entries.some((e) => e.isIntersecting)) { io.disconnect(); play(); }
    }, { threshold: 0.35 });
    io.observe(root);
  }
</script>
