---
// A home-page section: an anchor, a title and an optional intro. On wide
// screens the title and the intro share a row, so the head uses the width.
// Content goes in the default slot. `raised` sections sit on the dot grid;
// plain ones on the bare canvas.
interface Props { id: string; title: string; intro?: string; tone?: 'plain' | 'raised' }
const { id, title, intro, tone = 'plain' } = Astro.props;
---
<section id={id} class:list={['section', tone]} aria-labelledby={`${id}-title`}>
  <div class="wrap">
    <header class:list={['head', { split: !!intro }]}>
      <h2 id={`${id}-title`}>{title}</h2>
      {intro && <p class="lede intro">{intro}</p>}
    </header>
    <slot />
  </div>
</section>

<style>
  .section { padding: var(--space-7) 0; position: relative; isolation: isolate; }
  @media (min-width: 960px) { .section { padding: var(--space-8) 0; } }
  .raised::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: radial-gradient(circle, var(--dot) 1px, transparent 1.5px) 0 0 / 12px 12px;
    mask-image: linear-gradient(to bottom, transparent, #000 7rem, #000 calc(100% - 7rem), transparent);
  }
  .head { margin-bottom: var(--space-6); }
  h2 { font-size: var(--step-4); max-width: 20ch; margin: 0; }
  .intro { margin: var(--space-4) 0 0; color: var(--muted); }
  @media (min-width: 960px) {
    .head { margin-bottom: var(--space-7); }
    .split {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: var(--space-7);
      align-items: start;
    }
    .split .intro {
      margin: 0.45rem 0 0;
      padding-left: var(--space-5);
      border-left: 1px solid color-mix(in srgb, var(--accent) 45%, var(--border));
    }
  }
</style>
