---
// The agents Specstride can drive (proposer) or use as judge (critic), with
// their adapter status, plus the discovery tile: the list is a starting point.
import { getCollection } from 'astro:content';
import StatusChip from './StatusChip.astro';
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const harnesses = (await getCollection('harnesses')).sort((a, b) => a.data.order - b.data.order);
---
<ul class="hgrid" role="list">
  {harnesses.map((h) => (
    <li class="tile">
      <div class="row">
        <span class="hname mono">{h.data.url ? <a href={h.data.url}>{h.data.name}</a> : h.data.name}</span>
        <StatusChip status={h.data.status} />
      </div>
      <p class="roles mono">{h.data.roles.join(' · ')}{h.data.testedToday && <span class="tested"> · tested in the CLI</span>}</p>
      {!compact && <p class="hnote">{h.data.note}</p>}
    </li>
  ))}
  <li class="tile discover">
    <div class="row">
      <span class="hname mono">+ yours</span>
      <StatusChip status="in-progress" />
    </div>
    <p class="roles mono">discovered</p>
    {!compact && <p class="hnote">Agents you already have, found and probed on your machine, usable through a generic adapter even with no dedicated one.</p>}
  </li>
</ul>

<style>
  .hgrid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-3); grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr)); }
  .tile { border: 1px solid var(--border); border-radius: var(--radius); padding: var(--space-4); background: var(--surface); min-width: 0; }
  .discover { border-style: dashed; }
  .row { display: flex; align-items: center; justify-content: space-between; gap: var(--space-2); }
  .hname { color: var(--fg-strong); font-weight: 700; }
  .hname a { color: inherit; text-decoration: none; }
  .hname a:hover { color: var(--accent); text-decoration: underline; }
  .roles { font-size: 0.75rem; color: var(--muted); margin: var(--space-2) 0 0; }
  .tested { color: var(--ok); }
  .hnote { font-size: 0.875rem; margin: var(--space-2) 0 0; }
</style>
