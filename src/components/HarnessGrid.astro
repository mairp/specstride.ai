---
// The agents Specstride runs: the implementer (the coding agent) and the
// reviewer (the judge), chosen independently. The data's internal role enum is
// the product's own (`proposer`/`critic`); the words on the page are
// implementer and reviewer.
import { getCollection } from 'astro:content';
import { isAvailable } from '../lib/site';
import { inlineMd } from '../lib/inline-md';
const ROLE = { proposer: 'implementer', critic: 'reviewer' } as const;
interface Props { compact?: boolean }
const { compact = false } = Astro.props;
const harnesses = (await getCollection('harnesses')).filter(isAvailable).sort((a, b) => a.data.order - b.data.order);
---
<ul class="hgrid" role="list">
  {harnesses.map((h) => (
    <li class="tile card card-top">
      <p class="hname">{h.data.url ? <a href={h.data.url}>{h.data.name}</a> : h.data.name}</p>
      <p class="roles mono">{h.data.roles.map((r) => ROLE[r]).join(' · ')}</p>
      {!compact && <p class="hnote" set:html={inlineMd(h.data.note)} />}
    </li>
  ))}
</ul>

<style>
  .hgrid { list-style: none; padding: 0; margin: 0; display: grid; gap: var(--space-4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .hname { font-family: var(--font-display); font-size: var(--step-2); font-weight: 500; color: var(--fg-strong); margin: 0; }
  .hname a { color: inherit; text-decoration: none; }
  .hname a:hover { color: var(--accent); text-decoration: underline; }
  .roles { font-size: 0.75rem; color: var(--accent); margin: var(--space-2) 0 0; }
  .hnote { font-size: 0.875rem; margin: var(--space-2) 0 0; }
</style>
